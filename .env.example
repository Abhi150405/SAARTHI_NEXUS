# Environment Variables Template for SAARTHI NEXUS

# API Keys
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Database Configuration
MONGO_URI=mongodb://localhost:27017/saarthi_nexus

# OAuth / Auth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email / SMTP Configuration (Optional in local dev: simulates OTP in terminal if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="SAARTHI NEXUS"
SMTP_TLS=true
SMTP_SSL=false

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api

